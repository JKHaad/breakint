# Copy this file to .env and fill in the values below.
# Never commit the real .env file — keep it out of version control.

PORT=3001

# Where visitor inquiries are delivered to
RECEIVER_EMAIL=info@breakint.com

# Comma-separated list of domains allowed to call this API
ALLOWED_ORIGINS=https://breakint.com,https://www.breakint.com

# --- SMTP "sender" mailbox ---
# This is the mailbox that authenticates with your SMTP provider and actually
# sends the email on the visitor's behalf. Left blank intentionally — fill
# these in once you've decided which mailbox/provider to send from
# (e.g. Gmail, Outlook, Zoho, SendGrid, Amazon SES, your hosting provider's SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
